# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# 企业微信机器人 Webhook，多个地址用英文逗号分隔
WECOM_WEBHOOKS=

# 钉钉（默认关闭）
DINGTALK_ENABLED=false
DINGTALK_WEBHOOKS=

# 去重窗口（秒）
ALERT_WINDOW_TTL=300

# 服务监听（修改 HOST/PORT 需重启进程）
HOST=0.0.0.0
PORT=8080

# 时区与每日报告时间
TZ=Asia/Shanghai
REPORT_HOUR=9
REPORT_MINUTE=0

LOG_LEVEL=INFO
FLASK_DEBUG=false
HOT_RELOAD_INTERVAL=2
